# Copy this file to `.env` and adjust local paths as needed.
# `.env` is intentionally ignored by git.

# Preferred Godot executable or unpacked Godot directory.
# Windows-style %VAR% references are expanded by the PowerShell wrappers.
TOMOCOL_GODOT_EXE=%USERPROFILE%\Downloads\Godot_v4.6.2-stable_win64.exe

# Optional semicolon-separated search roots used when TOMOCOL_GODOT_EXE is unset.
TOMOCOL_GODOT_SEARCH_ROOTS=%USERPROFILE%\Downloads;%USERPROFILE%\Desktop;%ProgramFiles%

# Optional repo-relative or absolute paths.
TOMOCOL_GODOT_PROJECT_PATH=godot-project
TOMOCOL_GODOT_RUNTIME_ROOT=artifacts\godot-runtime
TOMOCOL_CAPTURE_OUTPUT_DIR=screen_shots
